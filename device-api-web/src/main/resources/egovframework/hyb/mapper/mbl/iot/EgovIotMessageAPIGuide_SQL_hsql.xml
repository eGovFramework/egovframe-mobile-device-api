<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.hyb.mbl.iot.service.impl.IotMessageAPIDAO">

	<resultMap id="iotMessageInfo" type="egovframework.hyb.mbl.iot.service.IotMessageAPIVO">
		<result property="sn" column="SN"/>
		<result property="uuid" column="UUID"/>
		<result property="topic" column="TOPIC"/>
		<result property="payload" column="PAYLOAD"/>
		<result property="direction" column="DIRECTION"/>
		<result property="messageType" column="MESSAGETYPE"/>
		<result property="timestamp" column="TIMESTAMP"/>
		<result property="useYn" column="USEYN"/>
	</resultMap>

	<insert id="insertIotMessageInfo">
		<selectKey keyProperty="sn" resultType="int" order="BEFORE">
		   SELECT (COALESCE(MAX(SN), 0)+1) sn from IOT_MESSAGE WHERE UUID = #{uuid}
		</selectKey>
		INSERT INTO IOT_MESSAGE (SN, UUID, TOPIC, PAYLOAD, DIRECTION, MESSAGETYPE, USEYN, "TIMESTAMP")
		VALUES (#{sn}, #{uuid}, #{topic}, #{payload}, #{direction}, #{messageType}, #{useYn}, #{timestamp})
	</insert>

	<select id="selectIotMessageInfoList" parameterType="egovframework.hyb.mbl.iot.service.IotMessageAPIVO" resultMap="iotMessageInfo">
		SELECT SN, UUID, TOPIC, PAYLOAD, DIRECTION, MESSAGETYPE, USEYN, "TIMESTAMP"
		FROM IOT_MESSAGE
		WHERE USEYN='Y'
			AND UUID = #{uuid}
		ORDER BY SN DESC
	</select>

	<delete id="deleteIotMessageInfo">
		DELETE FROM IOT_MESSAGE
		WHERE UUID = #{uuid}
	</delete>

</mapper>
